# EC Service configuration. Copy to .env for local dev.

PORT=8080
LOG_LEVEL=info

# backend: "memory" (default, no infra) | "postgres" (Postgres store + durable queue)
BACKEND=memory
# pglite://memory (embedded, default) | pglite://./data | postgres://user:pass@host:5432/db (needs `npm i pg`)
DATABASE_URL=pglite://memory

# object store for EC documents: "memory" | "local:<dir>"
STORAGE=memory

# provider routing: comma-separated, first that supports() wins; rest are fallback
PROVIDER_ORDER=mock
# real order once adapters are wired: aggregator:landeed,aggregator:surepass,automation

# aggregator credentials (leave blank until onboarded)
LANDEED_BASE_URL=
LANDEED_API_KEY=
SUREPASS_BASE_URL=
SUREPASS_API_KEY=

# real TNREGINET portal — only set these on an India-region host during a live
# test run (see verification/india-run-wizard.sh). Never commit real values.
AUTOMATION_PORTAL_URL=
AUTOMATION_USERNAME=
AUTOMATION_PASSWORD=

# webhook + document-URL signing secret shared with the ERP
WEBHOOK_SIGNING_SECRET=dev-secret-change-me

# tenant API keys (client -> key). JSON object.
TENANT_KEYS={"erp-staging":"dev-tenant-key"}

# per-tenant rate limit
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# human-in-the-loop: "auto" (phase-0 demo, no console) | "console" (operators)
HITL_MODE=auto

# dedupe window for informational ECs (days); 0 disables
DEDUPE_WINDOW_DAYS=14
